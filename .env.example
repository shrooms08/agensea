# Live-head RPC (Chainstack). Required. Non-archive: only ~100 blocks of lookback.
BSC_RPC=
BSC_WSS=

# Historical log source. Required for P6-P9 (eth_getLogs over historical ranges).
# BNB Smart Chain mainnet endpoint URL, e.g. https://bnb-mainnet.g.alchemy.com/v2/<key>
ALCHEMY_BSC=

# DEAD PATH - not read by any probe. Kept only so an existing .env still loads.
#   api.bscscan.com V1        -> NOTOK, deprecated (migration message)
#   api.etherscan.io/v2 cid=56 -> NOTOK, "Free API access is not supported for this chain."
BSCSCAN_KEY=

# Altana session-key spike. MUST be 97 (BNB Smart Chain Testnet).
# The MCP server and SDK BOTH default to MAINNET (chain 56) when this is unset:
#   @altananetwork/mcp src/index.ts -> NETWORKS[requestedChain] ?? BNB
# Register the MCP server with it explicitly:
#   claude mcp add altana -e ALTANA_CHAIN=97 -- bunx @altananetwork/mcp
ALTANA_CHAIN=97

# Admin signer for the Altana smart account. Testnet key only. Never commit.
AGENT_KEY=
