# Live-head RPC for the Phase 0 diagnostic probes in apps/indexer/scripts.
# Non-archive: only ~100 blocks of lookback (measured against Chainstack's
# Developer plan, since decommissioned). Any working BSC mainnet RPC works.
# NOT used by the app — production reads run on ALCHEMY_BSC.
BSC_RPC=
BSC_WSS=

# Historical log source. Required for P6-P9 (eth_getLogs over historical ranges).
# BNB Smart Chain mainnet endpoint URL, e.g. https://bnb-mainnet.g.alchemy.com/v2/<key>
ALCHEMY_BSC=

# DEAD PATH - not read by any probe. Kept only so an existing .env still loads.
#   api.bscscan.com V1        -> NOTOK, deprecated (migration message)
#   api.etherscan.io/v2 cid=56 -> NOTOK, "Free API access is not supported for this chain."
BSCSCAN_KEY=

# Altana session-key spike. MUST be 97 (BNB Smart Chain Testnet).
# The MCP server and SDK BOTH default to MAINNET (chain 56) when this is unset:
#   @altananetwork/mcp src/index.ts -> NETWORKS[requestedChain] ?? BNB
# Register the MCP server with it explicitly:
#   claude mcp add altana -e ALTANA_CHAIN=97 -- bunx @altananetwork/mcp
ALTANA_CHAIN=97

# Admin signer for the Altana smart account. Testnet key only. Never commit.
AGENT_KEY=

# Supabase. SUPABASE_SERVICE_KEY bypasses RLS — server-side only, NEVER in a
# browser bundle. Dashboard > Project Settings > API Keys > Secret key (sb_secret_…).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Publishable ("anon") key. This is PUBLIC by design — it ships in the frontend
# bundle. Safe only because 003_rls.sql enables RLS and grants anon SELECT-only
# on bazaar_resources, bazaar_accepts, agent_liveness, agents (+ the two views),
# and NO access at all to sweep_cursor. Verified empirically, not by reading the
# policy: anon INSERT/UPDATE/DELETE all return 401 42501, and sweep_cursor
# returns 401 on SELECT.
# Dashboard > Project Settings > API Keys > Publishable key (sb_publishable_…).
SUPABASE_ANON_KEY=

# Bearer token for POST /api/revalidate (on-demand ISR after a sweep).
REVALIDATE_SECRET=
